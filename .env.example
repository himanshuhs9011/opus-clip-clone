# --- ASR -------------------------------------------------------------------
WHISPER_MODEL=large-v3-turbo  # tiny | base | small | medium | large-v3-turbo | large-v3
WHISPER_DEVICE=auto           # auto | cuda | cpu
WHISPER_COMPUTE=auto          # auto | float16 | int8 | int8_float16
WHISPER_LANGUAGE=             # empty = auto-detect

# --- AI clip finder ----------------------------------------------------------
# ollama = local & free (default) | openrouter = optional cloud | none = rules only
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# OpenRouter (optional) - also settable from the Settings screen in the app
# OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash
LLM_FALLBACK_MODELS=
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- links -------------------------------------------------------------------
# smart = audio first, then only the video around each clip (default, ~85-95% less data)
# full  = download the whole video like before
DOWNLOAD_MODE=smart

# --- rendering ---------------------------------------------------------------
ENCODER=auto                  # auto (NVENC if available) | nvenc | x264
RENDER_WORKERS=3              # clips rendered in parallel
OUT_FPS=30
CRF=20
X264_PRESET=veryfast
MAX_CLIPS=6
REFRAME_SAMPLE_FPS=4
